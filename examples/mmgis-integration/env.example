# Copy to .env next to docker-compose.yml, then change SECRET and DB_PASS.
# Only the variables this example needs are listed; the full set is documented at
# https://nasa-ammos.github.io/MMGIS/setup/envs and in MMGIS' sample.env.

SERVER=node
PORT=8888

# 'local' blocks anonymous users but lets the first POST to /api/users/first_signup
# create the admin account that the Configure page and /api/configure/* require.
AUTH=local
AUTH_LOCAL_ALLOW_SIGNUP=false

# 'development' shows the Configure and Documentation links on the landing page.
NODE_ENV=development
HTTPS=false

# Change this: it signs the session cookies.
SECRET=change-me-to-a-long-random-string

VERBOSE_LOGGING=false

# The adjacent servers are not in this compose file, so they must be off.
WITH_STAC=false
WITH_TIPG=false
WITH_TITILER=false
WITH_TITILER_PGSTAC=false
WITH_VELOSERVER=false

DB_HOST=db
DB_PORT=5432
DB_NAME=mmgis
DB_USER=mmgis
DB_PASS=change-me
