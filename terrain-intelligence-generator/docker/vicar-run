#!/bin/bash
# Run a VICAR program and translate its exit code into shell conventions.
#
# VICAR programs return 1 on a successful run, so `set -e`, `&&` chains and
# CI steps all read a normal run as a failure. They also return 1 when TAE
# rejects the invocation (missing parameter, unknown keyword), so the code
# alone cannot separate success from a typo -- the only signal is the
# [TAE-...] diagnostic VICAR prints on stdout.
#
# Codes this produces:
#   0     the program ran
#   1     TAE rejected the invocation
#   255   the program called abend()
#   >128  killed by a signal
#   other passed through unchanged
#
# Usage: vicar-run /path/to/program [args...]

program=$1
shift

normalize() {
    # VICAR's success code is 1; anything higher is a genuine failure.
    if [ "$1" -le 1 ]; then
        exit 0
    fi
    exit "$1"
}

# One private directory, so the FIFO is created under a name nothing else can
# reach rather than at a path reserved by mktemp -u.
tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT
status=$tmpdir/status
last_line=$tmpdir/last-line
produced_output=$tmpdir/produced-output
transcript=$tmpdir/transcript
mkfifo "$transcript"

# Only the last meaningful line is ever needed, so the output streams through
# a filter that keeps just that line; nothing is stored in full. The Script
# lines are script(1)'s own banners around the transcript.
begin_capture() {
    exec 9<> "$transcript"  # a writer of our own, so the filter cannot block on open
    awk -v last_line="$last_line" -v produced_output="$produced_output" '
        !/^[[:space:]]*$/ && !/^Script (started|done) on / { last = $0 }
        END {
            if (NR) print "1" > produced_output
            if (last != "") print last > last_line
        }
    ' < "$transcript" 9>&- &
    filter_pid=$!
}

end_capture() {
    exec 9>&-
    wait "$filter_pid"
}

# fd 9 is closed for everything the program can outlive: a descendant holding
# the write end would keep the filter waiting for input that never comes.
run_through_pipe() {
    "$program" "$@" 9>&- | tee "$transcript" 9>&-
    exit_code=${PIPESTATUS[0]}
}

# script(1) reads the terminal to feed the pty, which stops a background job
# with SIGTTIN, so the pty is only for a foreground job on a full terminal.
foreground() {
    local fields
    read -r fields < /proc/self/stat || return 1
    # shellcheck disable=SC2086
    set -- ${fields#*) }  # state ppid pgrp session tty_nr tpgid
    [ "$3" = "$6" ]
}

begin_capture

if [ -t 0 ] && [ -t 1 ] && [ -t 2 ] && foreground && command -v script > /dev/null; then
    # A pty, not a pipe, so prompts and Motif tools still work. The program's
    # own status goes to a file because script's exit code cannot distinguish
    # a VICAR run from script failing to start. SHELL is pinned because
    # script -c runs through it and the quoting is bash's.
    SHELL=/bin/bash script -qfc \
        "$(printf '%q ' "$program" "$@"); printf %s \$? > $(printf '%q' "$status")" "$transcript" 9>&-
    script_code=$?
    end_capture
    if [ -s "$status" ]; then
        exit_code=$(cat "$status")
    elif [ -s "$produced_output" ]; then
        exit_code=$script_code  # the program ran; only its status was lost
    else
        begin_capture  # script never started it
        run_through_pipe "$@"
        end_capture
    fi
else
    run_through_pipe "$@"
    end_capture
fi

case $exit_code in
    ''|*[!0-9]*) exit_code=1 ;;  # the status file held something unusable
esac

# A rejection stops the run, so the diagnostic is the last line; matching it
# anywhere would fail an interactive session that recovered from one.
last=$(cat "$last_line" 2> /dev/null)
if [ "$exit_code" -le 1 ] && [[ $last == *'[TAE-'* || $last == *'** ABEND called **'* ]]; then
    exit 1
fi

normalize "$exit_code"
